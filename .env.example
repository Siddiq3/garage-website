# Backend origin WITHOUT the /api/v1 suffix. NEXT_PUBLIC_* values are inlined into
# the browser bundle, so never put a secret (Cashfree secret key, JWT secret) here.
#
# Local backend (npm run dev in garage-saas-backend): http://localhost:4000
# Deployed (prod): https://xqa0179tu3.execute-api.ap-south-1.amazonaws.com
API_BASE_URL=http://localhost:4000

# Shown on the contact, privacy, terms and refund pages. Cashfree requires real
# business details on a live account, so fill these in before going live.
NEXT_PUBLIC_BUSINESS_NAME=Garage Manager
NEXT_PUBLIC_BUSINESS_ADDRESS=Hyderabad, Telangana, India
NEXT_PUBLIC_SUPPORT_EMAIL=support@spannerbook.example
NEXT_PUBLIC_SUPPORT_PHONE=+91 90000 00000
# Named privacy contact, published on the privacy policy as Indian IT Rules require.
NEXT_PUBLIC_GRIEVANCE_OFFICER=The Grievance Officer
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@spannerbook.example
